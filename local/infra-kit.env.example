# Copie para ~/.config/infra-kit.env (no Windows: C:\Users\<voce>\.config\infra-kit.env)

# IP da VPS e seu usuário nela
VPS_HOST=
VPS_USER=psawczuk

# Chave privada de deploy, sem passphrase, que vai para o secret VPS_SSH_KEY.
# A chave pública correspondente precisa estar no ~/.ssh/authorized_keys da VPS.
DEPLOY_KEY=~/.ssh/deploy_vps

# Repositório com o workflow reutilizável
INFRA_REPO=pedrosawczuk/infra
