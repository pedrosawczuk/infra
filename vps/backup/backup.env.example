# Copie para ~/komodo/backup.env e rode: chmod 600 ~/komodo/backup.env

BACKUP_DIR=$HOME/backups
KEEP_DAILY=7
KEEP_WEEKLY=4
KEEP_MONTHLY=6

PG_CONTAINER=postgres
PG_ADMIN_USER=admin

REDIS_CONTAINER=redis
REDIS_ENV_FILE=$HOME/komodo/redis/.env

KOMODO_BACKUPS_DIR=/etc/komodo/backups
CONFIG_SOURCE_DIR=$HOME/komodo

RCLONE_BIN=$HOME/.local/bin/rclone
RCLONE_REMOTE=gdrive-crypt:
REMOTE_TRASH_DAYS=30
REMOTE_MAX_DELETE=40

RESTORE_TEST_WEEKDAY=7
SHRINK_ALERT_PERCENT=50
MIN_FREE_MB=1024
LOG_RETENTION_DAYS=60

HC_PING_URL=

# Garage (S3). Se o container não existir, essa parte é pulada.
GARAGE_CONTAINER=garage
GARAGE_S3_ENDPOINT=http://127.0.0.1:3900
S3_HISTORY_DAYS=60
S3_MAX_DELETE=500
S3_SHRINK_ALERT_PERCENT=50
DISK_ALERT_PERCENT=80
