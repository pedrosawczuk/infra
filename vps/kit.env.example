# Copie para ~/komodo/kit.env, preencha e rode: chmod 600 ~/komodo/kit.env
# Este arquivo tem as senhas de administração. Nunca faça commit dele.

# Seu usuário do GitHub (dono das imagens no GHCR)
GHCR_OWNER=pedrosawczuk

# IP público da VPS
VPS_HOST=

# Postgres
PG_CONTAINER=postgres
PG_ADMIN_USER=admin
PG_ADMIN_PASSWORD=

# Redis (só se for usar --redis)
REDIS_CONTAINER=redis
REDIS_ADMIN_USER=admin
REDIS_ADMIN_PASSWORD=

# Garage / S3 (só se for usar --s3). Não precisa de senha aqui: o new-app usa o CLI do container.
GARAGE_CONTAINER=garage
S3_DEFAULT_QUOTA=20GiB

# Caddy
CADDY_CONTAINER=caddy
